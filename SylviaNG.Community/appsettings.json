  "FileStorage": {
    // Physical folder (relative to the app's ContentRootPath, or an absolute path) that
    // FileUploadController writes uploaded bytes into. Program.cs's UseStaticFiles should be
    // pointed at this same folder with RequestPath "/uploads" so StoragePath values returned by
    // FileUploadController (e.g. "uploads/Post/2026-07/<guid>.png") are directly servable.
    "LocalRootPath": "wwwroot/uploads"
  }
}
